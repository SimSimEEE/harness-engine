{
  "version": "4",
  "about": "결정론 시크릿 스캔(secret-scan.sh)의 정본. agents/secret-scanner.md 는 이 파일을 가리킨다 — 표를 옮겨 적지 마라. 패턴·경로를 바꾸면 version 을 올린다(분류와 기록이 다른 판으로 스캔하면 기록이 거부된다).",
  "grades": {
    "error": "ERROR 후보 — 추가 라인. secret-scanner 가 허용 패턴을 적용해 ERROR 여부를 판정한다",
    "suspect": "의심 — 추가 라인. secret-scanner 의 판단이 필요하다",
    "warning": "WARNING 후보 — 추가 라인(머신 절대경로)",
    "removed": "삭제 라인에서 ERROR 후보 패턴이 걸렸다 — 이미 히스토리에 있으므로 WARNING 후보로만 본다"
  },
  "patterns": [
    {"name": "pem-private-key", "grade": "error", "scanRemoved": true,
     "regex": "-----BEGIN ([A-Z]+ )?PRIVATE KEY-----"},
    {"name": "payment-live-key", "grade": "error", "scanRemoved": true,
     "regex": "\\b[sp]k_live_[A-Za-z0-9]{20,}"},
    {"name": "jwt", "grade": "error", "scanRemoved": true,
     "regex": "eyJ[A-Za-z0-9_-]{20,}\\.[A-Za-z0-9_-]{20,}\\.[A-Za-z0-9_-]{20,}"},
    {"name": "aws-access-key", "grade": "error", "scanRemoved": true,
     "regex": "\\bAKIA[0-9A-Z]{16}\\b"},
    {"name": "aws-temp-key", "grade": "error", "scanRemoved": true,
     "regex": "\\bASIA[0-9A-Z]{16}\\b"},
    {"name": "aws-secret-key", "grade": "error", "scanRemoved": true,
     "regex": "(?i)aws_?secret_?access_?key\\W{0,4}[A-Za-z0-9/+=]{40}"},
    {"name": "issued-token", "grade": "error", "scanRemoved": true,
     "regex": "\\b(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{30,}|\\bxox[abpr]-[A-Za-z0-9-]{10,}|\\bglpat-[A-Za-z0-9_-]{20,}"},
    {"name": "password-assign", "grade": "error", "scanRemoved": true,
     "regex": "(?i)password\\s*[:=]\\s*['\"][^'\"]{4,}['\"]"},
    {"name": "secret-like-assign", "grade": "suspect", "scanRemoved": false,
     "regex": "(?i)(secret[_-]?(?:access[_-]?)?key|session[_-]?(?:token|key)|access[_-]?(?:token|key)|secret|token|api[_-]?key|private[_-]?key|hmac|passw(?:or)?d|pwd)[A-Za-z0-9_]*\\s*(?:=>|[:=])\\s*['\"][^'\"\\s]{8,}['\"]"},
    {"name": "secret-like-quoted-key", "grade": "suspect", "scanRemoved": false,
     "regex": "(?i)(secret[_-]?(?:access[_-]?)?key|session[_-]?(?:token|key)|access[_-]?(?:token|key)|secret|token|api[_-]?key|private[_-]?key|hmac|passw(?:or)?d|pwd)[A-Za-z0-9_-]*['\"]\\]?\\s*(?:=>|[:=])\\s*['\"][^'\"\\s]{8,}['\"]"},
    {"name": "env-key-secret-plain", "grade": "suspect", "scanRemoved": false,
     "regex": "(?i)^\\s*[A-Z0-9_]*(_KEY|_SECRET)\\s*[:=]\\s*['\"]?[^'\"\\s#]{8,}"},
    {"name": "password-assign-unquoted", "grade": "suspect", "scanRemoved": false,
     "regex": "(?i)(password|passwd|pwd)[A-Za-z0-9_]*\\s*[:=]\\s*[^\\s'\"#][^\\s#]{5,}"},
    {"name": "url-embedded-credentials", "grade": "suspect", "scanRemoved": false,
     "regex": "[a-z][a-z0-9+.-]*://[^\\s/:@]+:[^\\s/@]+@"},
    {"name": "payment-test-key", "grade": "suspect", "scanRemoved": false,
     "regex": "\\b[sp]k_test_[A-Za-z0-9]{10,}"},
    {"name": "machine-abs-path", "grade": "warning", "scanRemoved": false,
     "regex": "/(Users|home)/[A-Za-z0-9._-]+/"}
  ],
  "sensitivePathsSyntax": "레포 루트 기준 경로에 맞춘다. '/' 가 없는 패턴은 파일 이름(마지막 경로 조각)에, '/' 가 있는 패턴은 루트부터 전체 경로에 맞춘다. '*' 와 '?' 는 '/' 를 넘지 않고, '**' 조각은 0개 이상의 디렉터리다. 카테고리 rules.py 의 SECRET_SENSITIVE_EXTRA 가 같은 문법으로 더한다. 이 목록과 별개로, 내용을 스캔할 수 없는 바이너리 변경(numstat '-\\t-')은 이름과 무관하게 민감 경로로 본다.",
  "sensitivePaths": [
    "env/**",
    "*.env",
    "*.env.*",
    "**/config/**/*.yml",
    "**/config/**/*.yaml",
    "**/seed*/**",
    "**/fixtures/**",
    "*.pem",
    "*.key",
    "credentials*",
    "*.p12",
    "*.pfx",
    "*.jks",
    "*.keystore",
    "id_rsa*",
    "id_ed25519*"
  ]
}
